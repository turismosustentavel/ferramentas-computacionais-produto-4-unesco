# Copie para .env (que nao e versionado) ou defina as variaveis no sistema.
# Nenhuma chave e distribuida com o repositorio: cada usuario usa as proprias.

# Raiz dos dados. A arvore abaixo dela reproduz a pasta do convenio
# ("Entregas/Produto 4/...", "Levantamentos e Análises/Produto 4/...").
# Sem esta variavel, a raiz e a pasta dados/ do repositorio.
P4_DADOS=

# Pasta de trabalho da selecao dos pontos (selecao_pontos/)
P4_SELECAO_PONTOS=

# 1 = refaz as consultas pagas da selecao dos pontos (Google e TomTom) mesmo que
# os arquivos ja existam. Vazio: usa os arquivos gravados.
P4_REFAZER_COLETAS=

# Geocodificacao (Google Geocoding API)
GOOGLE_MAPS_API_KEY=

# Rotas (TomTom Route Monitoring API) e velocidades (TomTom Traffic API)
TOMTOM_API_KEY=

# Oferta de onibus: GeckoAPI (uma ou mais chaves separadas por virgula)
GECKOAPI_KEYS=

# Data da consulta de oferta (AAAA-MM-DD). Vazio: a data da coleta original,
# que so se reproduz a partir do cache.
GECKOAPI_DATA=
